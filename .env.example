# Copy this file to `.env` (in this same directory) and fill in the
# values you have keys for. PUT REAL KEYS ONLY IN `.env` (git-ignored) —
# never in this example file.
#
# Minimum to run anything: GEMINI_API_KEY (worker + embedding fallback).
# Web research uses TAVILY_API_KEY if set, else DuckDuckGo (no key).

# ─── Worker providers (the gateway picks among them per request) ──────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro

GITHUB_ACCESS_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini

OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ─── Embedding (Ollama default; Gemini fallback uses GEMINI_API_KEY above) ─
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# ─── MCP tool keys ─────────────────────────────────────────────────────────
TAVILY_API_KEY=              # optional; DDG is the fallback

# ─── Optional gateway tunables ─────────────────────────────────────────────
# LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github
# GATEWAY_V8_PORT=8108
